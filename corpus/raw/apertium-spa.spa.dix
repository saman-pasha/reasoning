<pardef n="hour-digital">
    <e><par n="hd-hour" /><par n="hd-separator" /><par n="hd-minute" /><p><l /><r><s n="num" /></r></p></e>
</pardef>

<pardef n="symbols">
  <e>       <p><l />      <r><s n="num" /></r></p></e>

  <e>       <p><l>%</l>     <r>%<s n="num" /></r></p></e>
