<pardef n="numeros">
 <e>       <re>[0-9]+([.,][0-9]+)?</re><par n="symbols" /></e>
 <e>       <re>[0-9]+([.,][0-9]+)+</re><p><l /><r><s n="num" /></r></p></e> 
</pardef>

